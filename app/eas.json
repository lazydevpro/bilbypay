{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CHAIN_ID": "143"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "testnet": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CHAIN_ID": "10143",
        "EXPO_PUBLIC_DEMO_KEY": "1"
      }
    },
    "testnet-passkey": {
      "extends": "testnet",
      "env": {
        "EXPO_PUBLIC_CHAIN_ID": "10143",
        "EXPO_PUBLIC_DEMO_KEY": "0",
        "EXPO_PUBLIC_RP_ID": "bilbypay.pages.dev",
        "APPLE_ASSOCIATED_DOMAINS_DEV": "1",
        "EXPO_PUBLIC_API_URL": "https://bilbypay-api.lazydevpro.workers.dev"
      }
    },
    "apk-testmode": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bilbypay-api.lazydevpro.workers.dev",
        "EXPO_PUBLIC_CHAIN_ID": "10143",
        "EXPO_PUBLIC_DIRECTORY_ADDRESS": "0x6CE6a93600D389247971Dd2B0F65ff07FEbE6219",
        "EXPO_PUBLIC_ESCROW_ADDRESS": "0x65Cf95BA67831B6A75a58eeB91bd99289A25EaAa",
        "EXPO_PUBLIC_RP_ID": "bilbypay.pages.dev",
        "EXPO_PUBLIC_DEMO_KEY": "1"
      }
    },
    "apk-passkey": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bilbypay-api.lazydevpro.workers.dev",
        "EXPO_PUBLIC_CHAIN_ID": "10143",
        "EXPO_PUBLIC_DIRECTORY_ADDRESS": "0x6CE6a93600D389247971Dd2B0F65ff07FEbE6219",
        "EXPO_PUBLIC_ESCROW_ADDRESS": "0x65Cf95BA67831B6A75a58eeB91bd99289A25EaAa",
        "EXPO_PUBLIC_RP_ID": "bilbypay.pages.dev",
        "EXPO_PUBLIC_DEMO_KEY": "0"
      }
    }
  }
}
