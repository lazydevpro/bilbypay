// The web build of the app (testnet, device-key accounts) as a static-assets Worker: https://bilbypay-app.lazydevpro.workers.dev
// Build + deploy: pnpm --dir app deploy:web (exports to dist-web/ against the hosted API, then wrangler deploy).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bilbypay-app",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist-web", "not_found_handling": "single-page-application" }
}
