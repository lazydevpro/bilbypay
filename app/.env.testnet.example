# Run the app against the BilbyPay server on Monad TESTNET (test money only).
# Hosted API (Cloudflare Worker, always on): https://bilbypay-api.lazydevpro.workers.dev
# cp .env.testnet.example .env   (works as-is against the hosted API).
EXPO_PUBLIC_API_URL=https://bilbypay-api.lazydevpro.workers.dev
# Or your own server on the LAN: EXPO_PUBLIC_API_URL=http://<your-ip>:8787
EXPO_PUBLIC_CHAIN_ID=10143
# Monad testnet v2 deployment (2026-10-01). Legacy v1 addresses are incompatible.
EXPO_PUBLIC_DIRECTORY_ADDRESS=0x6CE6a93600D389247971Dd2B0F65ff07FEbE6219
EXPO_PUBLIC_ESCROW_ADDRESS=0x65Cf95BA67831B6A75a58eeB91bd99289A25EaAa
# Optional independent read endpoint; unset uses the configured network's default endpoint.
# EXPO_PUBLIC_RPC_URL=https://your-testnet-rpc.example
# Device-local key instead of a passkey (testnet/mock only; ignored on mainnet). Remove once the passkey domain is live.
EXPO_PUBLIC_DEMO_KEY=1
# Passkey + claim-link domain (Cloudflare Pages, see site/README.md). Must match the native build's
# associated domains, so build with the same value (eas.json profile "testnet-passkey").
EXPO_PUBLIC_RP_ID=bilbypay.pages.dev
