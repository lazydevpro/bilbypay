# Copy to app/.env.local to run the app against the testnet API (Expo inlines EXPO_PUBLIC_* at build time).
# Your computer's LAN IP, so a phone on the same Wi-Fi can reach the API (or a tunnel URL):
EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
EXPO_PUBLIC_CHAIN_ID=10143
# Shows "Get $100 test money" in Settings (the API runs with DEV_FAUCET=1).
EXPO_PUBLIC_DEV_FAUCET=1
# Until the passkey domain serves AASA/assetlinks: keep a key on the device instead of a passkey.
# Testnet only — ignored on mainnet. Remove once passkeys work.
EXPO_PUBLIC_DEMO_KEY=1
