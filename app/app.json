{
  "expo": {
    "name": "BilbyPay",
    "slug": "bilbypay",
    "scheme": "bilbypay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF6EE",
    "ios": {
      "bundleIdentifier": "com.bilbypay.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bilbypay.app",
      "adaptiveIcon": {
        "backgroundColor": "#A8CEF2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "BilbyPay uses Face ID to confirm payments and keep your money safe."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "BilbyPay uses your contacts so you can pay friends by name. Numbers are only checked when you pick someone, and your contacts are never uploaded."
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "269f4d7b-9d7a-4e48-9091-cb10c3428415"
      }
    },
    "owner": "lazydevpro"
  }
}
