# BilbyPay server. Copy to server/.env and fill in. `pnpm --filter @bilbypay/server dev` reads it.

# ---------------------------------------------------------------- chain
# 143 = Monad mainnet (also used by the local anvil dev chain), 10143 = Monad testnet
CHAIN_ID=143
# Optional; defaults to the chain's public RPC. Local: http://127.0.0.1:8545
RPC_URL=
# Contract addresses: a deployment JSON (contracts/deployments/*.json)...
# Default: ../contracts/deployments/<CHAIN_ID>-v2.json. Local dev: ../contracts/deployments/local-v2.json
DEPLOYMENT_FILE=
# ...or explicit addresses (used when DEPLOYMENT_FILE is empty and AUSD_ADDRESS is set)
AUSD_ADDRESS=
STATA_ADDRESS=
DIRECTORY_ADDRESS=
# v2 directory deployment block, used to replay finalized registration events after restarts.
# Zero works for a local chain. Set the actual deployment block for hosted networks.
DIRECTORY_START_BLOCK=0
ESCROW_ADDRESS=
ROUTER_ADDRESS=
EXPLORER_URL=
POLLING_INTERVAL_MS=250

# ---------------------------------------------------------------- server keys
# Pays gas for every user action. On Monad keep it above 10 MON (gas is charged on the gas limit).
RELAYER_PRIVATE_KEY=
# Signs Bind/Claim attestations. Must equal the `verifier` set in BilbyDirectory and BilbyEscrow.
VERIFIER_PRIVATE_KEY=
# Calls router.sweep / escrow.refund. Must be a router keeper; defaults to the relayer key. Needs MON.
KEEPER_PRIVATE_KEY=
# Receives gift payments and pays refunds. Must equal BilbyEscrow.treasury. Holds no MON (it signs
# EIP-3009 authorizations; the relayer submits).
TREASURY_PRIVATE_KEY=

# ---------------------------------------------------------------- secrets
# HMAC key for phoneKey = HMAC-SHA256(pepper, E.164). Never change it after launch: every binding depends on it.
PHONE_PEPPER=
# 32 bytes, hex (0x…) or base64: signs phone and session tokens.  openssl rand -hex 32
TOKEN_SECRET=
# 32 bytes, hex or base64: AES-256-GCM key for gift card codes at rest.
GIFT_CODE_KEY=

# ---------------------------------------------------------------- OTP
# test = no SMS, code 000000 for +1555… numbers (or all numbers with OTP_TEST_ALL=1); twilio = Twilio Verify
OTP_PROVIDER=test
OTP_TEST_ALL=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------------------------------------------------------------- app
PORT=8787
# Comma-separated exact web origins allowed to call this API. Empty denies cross-origin browsers.
# Local preview: http://127.0.0.1:8081,http://localhost:8081 (no trailing slash or wildcard).
# Bearer-token requests only; this does not enable cookies or replace authentication.
CORS_ORIGINS=
# Base for claim links (https://bilbypay.com/c/<code>) and OG images
PUBLIC_BASE_URL=http://localhost:8787
APP_STORE_URL=
PLAY_STORE_URL=
DATABASE_PATH=./data/bilbypay.db
# Behind a proxy/load balancer: trust X-Forwarded-For for per-IP rate limits
TRUST_PROXY=0
# Sender warning window. The v2 contract independently enforces a seven-day reassignment delay.
REBIND_COOLDOWN_DAYS=7
ESCROW_EXPIRY_DAYS=14
ACTION_TTL_SECONDS=600

# ---------------------------------------------------------------- gift cards
# mock (default). laso / bitrefill register in src/giftcards/providers.ts
GIFT_PROVIDER=mock
# laso: LASO_PRIVATE_KEY (Base float key), BASE_RPC_URL. bitrefill: BITREFILL_API_ID + BITREFILL_API_SECRET.
# Full list: packages/giftcards/README.md. Provider records are stored encrypted with GIFT_CODE_KEY.
LASO_PRIVATE_KEY=
BASE_RPC_URL=
BITREFILL_API_ID=
BITREFILL_API_SECRET=

# Top-up from other networks (Aurora Intents). Without INTENTS_API_KEY a mock provider is used.
# See packages/topup/README.md.
TOPUP_PROVIDER=
INTENTS_API_KEY=
# Keep usdc: deliveries go to the treasury, which credits users AUSD 1:1 (src/topup.ts).
TOPUP_DESTINATION=usdc
# USDC on Monad (default: mainnet address from @bilbypay/core); used to verify deliveries.
USDC_ADDRESS=

# ---------------------------------------------------------------- Ramp hosted demo checkout
# Sandbox only: provider simulation never credits app balances, test balances, or the treasury.
# Live/production modes fail startup. No key means the app shows "not configured".
RAMP_MODE=disabled
# Obtain a sandbox integration key from Ramp. This is a hosted-widget integration identifier.
RAMP_HOST_API_KEY=
# Exact demo asset, validated against the provider catalogue. No automatic substitution.
# BASE_USDC is a Base test asset; this integration makes no Monad settlement claim.
RAMP_SANDBOX_ASSET=BASE_USDC
# Public HTTPS image URL required by Ramp's hosted integration.
RAMP_HOST_LOGO_URL=
# Public HTTPS origin that forwards POST /v1/funding/webhooks/ramp/:id to this server.
RAMP_WEBHOOK_BASE_URL=
# Exact allowed return origins. HTTP allowed only for loopback web development.
# Example: http://localhost:8081,http://127.0.0.1:8081,bilbypay://
# The only accepted return route is /funding; the server adds ?id=<session id>.
RAMP_RETURN_ORIGINS=

# ---------------------------------------------------------------- Burrow
# Rate shown in the app. If AAVE_POOL_ADDRESS is set, derived from Aave's current AUSD supply rate instead.
BURROW_RATE_PERCENT=4.2
AAVE_POOL_ADDRESS=
KEEPER_ENABLED=1
KEEPER_INTERVAL_MS=2000
KEEPER_DEBOUNCE_MS=3000
KEEPER_BLOCK_RANGE=100

# ---------------------------------------------------------------- Phase 0 relay spike (scripts/relay-3009.ts)
# The "user" account. Must hold 0 MON and some AUSD. Leave empty to generate one.
SENDER_PRIVATE_KEY=
RECIPIENT=
AMOUNT_USD=0.01
# Optional: override the token (used by the local anvil test with MockAUSD)
TOKEN_ADDRESS=
