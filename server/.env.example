# Phase 0 relay spike (scripts/relay-3009.ts). Copy to server/.env and fill in.
# 143 = Monad mainnet, 10143 = Monad testnet
CHAIN_ID=143
# Optional; defaults to the chain's public RPC
RPC_URL=
# Pays gas. On Monad keep it above 10 MON (gas is charged on the gas limit).
RELAYER_PRIVATE_KEY=
# The "user" account. Must hold 0 MON and some AUSD. Leave empty to generate one.
SENDER_PRIVATE_KEY=
RECIPIENT=
AMOUNT_USD=0.01
# Optional: override the token (used by the local anvil test with MockAUSD)
TOKEN_ADDRESS=
