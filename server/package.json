{
  "name": "@bilbypay/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "spike:relay": "tsx scripts/relay-3009.ts",
    "spike:relay:local": "bash scripts/local-relay-e2e.sh",
    "e2e:testnet": "node --env-file-if-exists=.env --import tsx scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@bilbypay/core": "workspace:*",
    "@bilbypay/giftcards": "workspace:*",
    "@bilbypay/topup": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  }
}
