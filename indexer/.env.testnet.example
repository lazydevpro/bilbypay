# BilbyPay indexer on Monad TESTNET v2 (2026-10-01, contracts/deployments/10143-v2.json).
# These are also the config.yaml defaults now, so only ENVIO_API_TOKEN is needed locally.
# cp .env.testnet.example .env   then add your ENVIO_API_TOKEN (https://envio.dev/app/api-tokens).
# Needs Docker for `pnpm dev` (local Postgres + Hasura), or deploy to Envio Cloud.
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

ENVIO_TESTNET_SKIP=false
ENVIO_TESTNET_DIRECTORY_ADDRESS=0x6CE6a93600D389247971Dd2B0F65ff07FEbE6219
ENVIO_TESTNET_ESCROW_ADDRESS=0x65Cf95BA67831B6A75a58eeB91bd99289A25EaAa
ENVIO_TESTNET_ROUTER_ADDRESS=0xec93D63127b20b2116d38e176448B515880AaBD9
ENVIO_TESTNET_START_BLOCK=67216804
ENVIO_TESTNET_AUSD_ADDRESS=0x281E5E2fFE4F6EEb887A0fe82E9859a7656ad300
ENVIO_TESTNET_STATA_ADDRESS=0xe589463D6EC1E05681dc4a4dA209EF9bEECc2Ed7
