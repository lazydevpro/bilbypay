# Copy to indexer/.env (git-ignored). Envio reads it for config.yaml interpolation and the
# handlers read the token overrides from process.env. Every variable must start with ENVIO_
# (Envio Cloud only passes ENVIO_* variables through).

# HyperSync API token (https://envio.dev/app/api-tokens). Required for HyperSync on Monad.
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# ---- Monad mainnet (chain 143): fill in after `forge script script/Deploy.s.sol` ----
ENVIO_MONAD_DIRECTORY_ADDRESS=
ENVIO_MONAD_ESCROW_ADDRESS=
ENVIO_MONAD_ROUTER_ADDRESS=
# Block of the first BilbyPay deployment tx (earliest of the three contracts).
ENVIO_MONAD_START_BLOCK=
# Optional: fallback RPC for realtime stalls (default https://rpc.monad.xyz).
# ENVIO_MONAD_RPC_URL=
# Optional token overrides (defaults: AUSD 0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a,
# stataAUSD 0x9e1AcC5BFbf34e2E579763cE14042d957719fE76).
# ENVIO_MONAD_AUSD_ADDRESS=
# ENVIO_MONAD_STATA_ADDRESS=

# ---- Monad testnet (chain 10143): skipped unless ENVIO_TESTNET_SKIP=false ----
ENVIO_TESTNET_SKIP=true
# ENVIO_TESTNET_DIRECTORY_ADDRESS=
# ENVIO_TESTNET_ESCROW_ADDRESS=
# ENVIO_TESTNET_ROUTER_ADDRESS=
# ENVIO_TESTNET_START_BLOCK=
# ENVIO_TESTNET_RPC_URL=
# ENVIO_TESTNET_AUSD_ADDRESS=
# ENVIO_TESTNET_STATA_ADDRESS=   # e.g. the MockStata deployment
